  "beats": [
    {
      "id": "b01",
      "narration": "This mod hides an entire second world inside Luanti, and it starts five thousand blocks under your feet.",
      "visual": {
        "template": "footage",
        "props": {
          "src": "footage/raw_nether.mp4",
          "in": 63.5,
          "zoom": 1.05,
          "zoom_to": 1.18,
